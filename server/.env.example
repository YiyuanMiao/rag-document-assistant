# ============================================================
# Model provider — swap OpenAI <-> Amazon Bedrock without code changes.
#   LLM_PROVIDER   = openai | bedrock   (chat + judge)
#   EMBED_PROVIDER = openai | bedrock   (defaults to LLM_PROVIDER)
# The repo defaults to OpenAI so it runs anywhere with just an API key.
# ============================================================
LLM_PROVIDER=openai
EMBED_PROVIDER=openai

# ---------- Option 1: OpenAI ----------
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-5
JUDGE_MODEL=gpt-5
EMBED_MODEL=text-embedding-3-small
# EMBED_DIM below must be 1536 for text-embedding-3-small.

# ---------- Option 2: Amazon Bedrock ----------
# Set LLM_PROVIDER=bedrock (and/or EMBED_PROVIDER=bedrock) to use these.
BEDROCK_REGION=us-west-2
BEDROCK_CHAT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_JUDGE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0     # 1024-dim -> set EMBED_DIM=1024
#
# Bedrock credentials use the standard AWS credential chain. Two setups:
#   (A) Amazon employee (Isengard): set BEDROCK_CREDS=ini-refresh and keep
#       ~/.aws/credentials fresh with the bundled loop:  ./refresh-creds.sh
#       (it runs `ada credentials update ... --provider isengard --once` every
#       10 min). The app re-reads the file periodically so long runs survive
#       token rotation. No personal cost.
BEDROCK_CREDS=default   # employee: set to "ini-refresh"; external customer: leave "default"
#   (B) External / personal AWS customer:
#         1) In the Bedrock console, request model access for the models above.
#         2) Create IAM creds with bedrock:InvokeModel and export them, e.g.:
#              AWS_ACCESS_KEY_ID=...
#              AWS_SECRET_ACCESS_KEY=...
#              AWS_SESSION_TOKEN=...        # only if temporary
#            (or set AWS_PROFILE=<profile>). This path is billed to your account.

# ---------- Embedding dimension (MUST match the active embedding model) ----------
EMBED_DIM=1536     # OpenAI text-embedding-3-small=1536 ; Bedrock Titan v2=1024
# Changing embedding provider/dimension requires a FRESH index (different OPENSEARCH_INDEX).

# ---------- OpenSearch ----------
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=MyPassword123!
OPENSEARCH_SSL_VERIFY=false          # local self-signed cert; set true in prod
OPENSEARCH_INDEX=rag-documents

# ---------- retrieval / chunking ----------
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# ---------- CRAG router ----------
ROUTER=off
# on: retrieve -> LLM grades sufficiency -> web only if needed -> one fused,
#     source-attributed answer. off: legacy (doc answer + separate web fallback).

# ---------- web fallback (SerpAPI MCP tool) ----------
SERPAPI_KEY=

PORT=5001
# MOCK_LLM=true      # skip real LLM/search calls (perf testing)
