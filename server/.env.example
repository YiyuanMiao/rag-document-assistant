# --- LLM / embeddings ---
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-5
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536            # must match EMBED_MODEL (Bedrock Titan v2 = 1024)

# --- OpenSearch ---
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=MyPassword123!
OPENSEARCH_SSL_VERIFY=false   # local self-signed cert; set true in prod
OPENSEARCH_INDEX=rag-documents

# --- retrieval / chunking ---
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# --- web fallback (SerpAPI MCP tool) ---
SERPAPI_KEY=...

# --- misc ---
PORT=5001
# MOCK_LLM=true            # skip real LLM/search calls (perf testing)
