# ===== Active provider: Bedrock (Amazon employee / Isengard) =====
LLM_PROVIDER=bedrock
EMBED_PROVIDER=bedrock
BEDROCK_REGION=us-west-2
BEDROCK_CHAT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_JUDGE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
EMBED_DIM=1024
BEDROCK_CREDS=ini-refresh
# ini-refresh: re-reads ~/.aws/credentials periodically so long runs survive token
# rotation. Keep it fresh with a background loop:  ./refresh-creds.sh

# ===== OpenAI fallback (used when LLM_PROVIDER/EMBED_PROVIDER=openai) =====
OPENAI_API_KEY=sk-your-openai-key-here
CHAT_MODEL=gpt-5
JUDGE_MODEL=gpt-5
EMBED_MODEL=text-embedding-3-small
# NOTE: EMBED_DIM must match the embedding provider (OpenAI=1536, Titan v2=1024).
# Switching embedding provider requires a fresh index with the matching dimension.

# ===== OpenSearch =====
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=MyPassword123!
OPENSEARCH_SSL_VERIFY=false
OPENSEARCH_INDEX=rag-tgcf

# ===== retrieval / chunking =====
TOP_K=30
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===== CRAG router =====
ROUTER=on
# on: retrieve -> LLM grades sufficiency -> optional web -> one fused answer.
# off: legacy (RAG answer + separate web-fallback answer).

# ===== web fallback (SerpAPI MCP tool) =====
SERPAPI_KEY=your-serpapi-key-here
# needed for the web leg; empty = web fallback degrades gracefully (doc-only answer).

PORT=5001
